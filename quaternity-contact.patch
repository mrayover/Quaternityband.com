diff --git a/src/contact.css b/src/contact.css
new file mode 100644
index 0000000..e84341b
--- /dev/null
+++ b/src/contact.css
@@ -0,0 +1,72 @@
+#contact .contact-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
+  gap: clamp(24px, 4vw, 56px);
+  align-items: start;
+  align-content: start;
+}
+
+#contact .contact-copy,
+#contact .contact-form {
+  min-width: 0;
+}
+
+#contact .contact-copy {
+  padding: 12px 4px;
+}
+
+#contact h3 {
+  margin: 0 0 20px;
+  font-size: clamp(1.5rem, 2.5vw, 2rem);
+  font-weight: 700;
+  line-height: 1.2;
+}
+
+#contact .contact-copy p {
+  max-width: 46ch;
+  margin: 0 0 20px;
+  font-size: 1rem;
+  line-height: 1.65;
+}
+
+#contact a {
+  text-decoration: underline;
+  text-underline-offset: 4px;
+  overflow-wrap: anywhere;
+}
+
+#contact a:focus-visible {
+  outline: 2px solid var(--ink);
+  outline-offset: 5px;
+}
+
+#contact .contact-email {
+  display: inline-block;
+  font-weight: 700;
+}
+
+#contact .contact-socials {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px 24px;
+  margin-top: 24px;
+}
+
+#contact iframe {
+  display: block;
+  width: 100%;
+  border: 0;
+  background: transparent;
+}
+
+#contact .contact-form-link {
+  margin: 12px 0 20px;
+  font-size: 0.875rem;
+}
+
+@media (max-width: 720px) {
+  #contact .contact-layout {
+    grid-template-columns: minmax(0, 1fr);
+    gap: 20px;
+  }
+}
