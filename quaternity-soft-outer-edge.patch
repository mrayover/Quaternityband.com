@@ -316,6 +316,35 @@ button {
   isolation: isolate;
 }
 
+/* One viewport-fixed feather outside the shell. Keep the original opaque
+   border and header backing: fading either of those independently would
+   expose scrolling content or double the opacity at their overlap.
+   This pseudo-element paints only the exterior side gutters, never content.
+   The existing isolated stacking context keeps it above the circle pattern
+   but behind all page and fixed-header elements. */
+.site-frame::before {
+  --outer-edge-fade: 32px;
+
+  content: "";
+  position: fixed;
+  z-index: -1;
+  top: 0;
+  bottom: 0;
+  left: 50%;
+  width: calc(min(1240px, 100%) + 2 * var(--outer-edge-fade));
+  transform: translateX(-50%);
+  pointer-events: none;
+
+  /* A 1px opaque overlap avoids a fractional-pixel crack at the border.
+     The middle of this layer stays transparent; nothing is blurred. */
+  background-image:
+    linear-gradient(to right, transparent, var(--ink) var(--outer-edge-fade)),
+    linear-gradient(to left, transparent, var(--ink) var(--outer-edge-fade));
+  background-size: calc(var(--outer-edge-fade) + 1px) 100%;
+  background-position: left top, right top;
+  background-repeat: no-repeat;
+}
